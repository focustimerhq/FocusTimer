<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <requires lib="libadwaita" version="1.0"/>
  <template class="FtPreferencesPanelNotifications" parent="FtPreferencesPanel">
    <property name="child">
      <object class="AdwToolbarView">
        <child type="top">
          <object class="AdwHeaderBar" id="content_headerbar">
            <property name="show-title">true</property>
          </object>
        </child>
        <property name="content">
          <object class="AdwPreferencesPage" id="page">
            <child>
              <object class="AdwPreferencesGroup">
                <property name="title" translatable="yes">Announcements</property>
                <child>
                  <object class="AdwSwitchRow" id="announce_about_to_end_switchrow">
                    <property name="title" translatable="yes">About to End Notification</property>
                  </object>
                </child>
                <child>
                  <object class="AdwComboRow" id="announcement_lead_time_comborow">
                    <property name="title" translatable="yes">Early Notice</property>
                    <property name="sensitive" bind-source="announce_about_to_end_switchrow" bind-property="active" bind-flags="sync-create"/>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="AdwPreferencesGroup">
                <property name="title" translatable="yes">Screen Overlay</property>
                <property name="description" translatable="yes">A full-screen notification intended to enforce taking a break.</property>
                <child>
                  <object class="AdwSwitchRow" id="screen_overlay_switchrow">
                    <property name="title" translatable="yes">Screen Overlay</property>
                  </object>
                </child>
                <child>
                  <object class="AdwComboRow" id="screen_overlay_lock_delay_comborow">
                    <property name="title" translatable="yes">Lock Delay</property>
                    <property name="subtitle" translatable="yes">Period of inactivity to lock the screen.</property>
                  </object>
                </child>
                <child>
                  <object class="AdwComboRow" id="screen_overlay_reopen_delay_comborow">
                    <property name="title" translatable="yes">Reopen Delay</property>
                    <property name="subtitle" translatable="yes">Period of inactivity to reopen the overlay after it gets dismissed.</property>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </property>
      </object>
    </property>
  </template>
</interface>

<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <requires lib="libadwaita" version="1.0"/>
  <template class="FtPreferencesPanelAutomation" parent="FtPreferencesPanel">
    <property name="child">
      <object class="AdwToolbarView">
        <child type="top">
          <object class="AdwHeaderBar">
            <property name="show-title">true</property>
            <child type="end">
              <object class="GtkButton">
                <property name="label" translatable="yes">_Log</property>
                <property name="use-underline">true</property>
                <property name="tooltip-text" translatable="yes">Show execution log</property>
                <property name="action-name">app.log</property>
                <property name="action-target">uint64 0</property>
              </object>
            </child>
          </object>
        </child>
        <property name="content">
          <object class="GtkBox">
            <property name="orientation">vertical</property>
            <child>
              <object class="AdwBanner" id="permissions_banner">
                <property name="title" translatable="yes">Extra permissions needed to run commands</property>
                <property name="button-label" translatable="yes">Learn More</property>
                <property name="button-style">suggested</property>
                <property name="revealed">false</property>
                <signal name="button-clicked" handler="on_permissions_banner_button_clicked"/>
              </object>
            </child>
            <child>
              <object class="AdwPreferencesPage" id="page">
                <property name="description" translatable="yes">Run shell commands automatically on timer events or conditions</property>
                <child>
                  <object class="AdwPreferencesGroup">
                    <child>
                      <object class="AdwPreferencesRow" id="add_row">
                        <property name="activatable">true</property>
                        <property name="selectable">false</property>
                        <child>
                          <object class="GtkImage">
                            <property name="icon-name">list-add-symbolic</property>
                            <property name="height-request">50</property>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </property>
      </object>
    </property>
  </template>
</interface>
